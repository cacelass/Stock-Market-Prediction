#!/usr/bin/env bash
#
# init.sh - puerta de entrada del arnes de edgebet
#
# Uso:
#   ./init.sh              estructura + suite de tests
#   ./init.sh --quick      solo checks estructurales
#   ./init.sh --json       resultado estructurado para agentes
#
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT" || exit 1

QUICK=0
JSON=0
for arg in "$@"; do
  case "$arg" in
    --quick) QUICK=1 ;;
    --json) JSON=1 ;;
    -h|--help)
      # Solo el bloque de comentarios de cabecera (tras el shebang), sin un
      # rango fijo que pueda alcanzar `set -uo pipefail` al crecer el fichero.
      awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
      exit 0
      ;;
    *)
      printf "init.sh: opcion desconocida '%s'\n" "$arg" >&2
      exit 1
      ;;
  esac
done

ERRORS=0
WARNINGS=0
REPORT=""

record() {
  REPORT="${REPORT}${1}"$'\t'"${2}"$'\t'"${3}"$'\n'
}

ok() {
  record "ok" "$1" "$2"
  [ "$JSON" -eq 1 ] || printf '  \033[32mOK\033[0m %-22s %s\n' "$1" "$2"
}

warn() {
  record "warn" "$1" "$2"
  WARNINGS=$((WARNINGS + 1))
  [ "$JSON" -eq 1 ] || printf '  \033[33mWARN\033[0m %-19s %s\n' "$1" "$2"
}

fail() {
  record "fail" "$1" "$2"
  ERRORS=$((ERRORS + 1))
  [ "$JSON" -eq 1 ] || printf '  \033[31mFAIL\033[0m %-19s %s\n' "$1" "$2"
}

section() {
  [ "$JSON" -eq 1 ] || printf '\n\033[1m%s\033[0m\n' "$1"
}

if [ "$JSON" -eq 1 ]; then
  :
else
  printf '\n\033[1m== init.sh - arnes de edgebet ==\033[0m\n'
fi

# Prefer uv so the check uses the locked project environment. This also works
# on hosts where only uv is on PATH and there is no `python` alias.
PY=()
PY_LABEL=""
if command -v uv >/dev/null 2>&1; then
  PY=(uv run python)
  PY_LABEL="uv run python"
elif command -v python3 >/dev/null 2>&1; then
  PY=(python3)
  PY_LABEL="python3"
elif command -v python >/dev/null 2>&1; then
  PY=(python)
  PY_LABEL="python"
fi

run_py() {
  "${PY[@]}" "$@"
}

section "Entorno"
if [ "${#PY[@]}" -eq 0 ]; then
  fail "python" "no se encontro Python ni uv en PATH"
else
  PY_VERSION="$(run_py -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null || true)"
  if [ -z "$PY_VERSION" ]; then
    fail "python" "$PY_LABEL no ejecuta codigo"
  elif [ "$PY_VERSION" = "3.12" ]; then
    ok "python" "$PY_LABEL $PY_VERSION"
  else
    warn "python" "$PY_LABEL es $PY_VERSION; pyproject permite >=3.12,<3.14"
  fi
fi

if command -v uv >/dev/null 2>&1; then
  ok "uv" "$(uv --version 2>/dev/null | head -1)"
  TEST_RUNNER=(uv run python -m pytest)
else
  warn "uv" "no instalado; se usara pytest del entorno actual"
  TEST_RUNNER=("${PY[@]}" -m pytest)
fi

if [ -d ".venv" ]; then
  ok "venv" ".venv presente"
else
  warn "venv" "sin .venv; uv run puede crear o reutilizar el entorno"
fi

section "Arnes"
# featureslist.json ya no es obligatorio: desde MIG-GEAS-001 el backlog vive en
# el servidor y este fichero es solo el archivo historico (se comprueba mas
# abajo, y solo como aviso de que no se ha vuelto a usar como fuente de verdad).
for required in AGENTS.md harness/progress/current.md harness/progress/history.md; do
  if [ -f "$required" ]; then
    ok "$(basename "$required")" "presente"
  else
    fail "$(basename "$required")" "falta $required"
  fi
done

MISSING_AGENTS=""
for agent_def in lider implementer reviewer explorer; do
  [ -f ".opencode/agents/${agent_def}.md" ] || MISSING_AGENTS="$MISSING_AGENTS $agent_def"
done
if [ -z "$MISSING_AGENTS" ]; then
  ok "subagentes" "lider, implementer, reviewer, explorer"
else
  fail "subagentes" "faltan definiciones:$MISSING_AGENTS"
fi

section "Backlog (GEAS)"
# El backlog vive en el servidor GEAS, no en un fichero (MIG-GEAS-001).
# featureslist.json se conserva como archivo historico: si aparece sin marcar
# como obsoleto, es que alguien lo ha vuelto a usar como fuente de verdad y eso
# si es un fallo, porque dos fuentes de verdad se desincronizan solas.
if [ -f "harness/featureslist.json" ] && [ "${#PY[@]}" -gt 0 ]; then
  ARCHIVE_OUT="$(run_py - <<'PYEOF'
import json
import sys

try:
    with open("harness/featureslist.json", encoding="utf-8") as fh:
        doc = json.load(fh)
except (OSError, json.JSONDecodeError) as exc:
    print(f"fail\tno se pudo leer harness/featureslist.json: {exc}")
    sys.exit(0)

if not isinstance(doc, dict):
    print("fail\tharness/featureslist.json no es un objeto")
    sys.exit(0)
migrated = doc.get("migrated_to")
features = doc.get("features")
if not isinstance(features, list):
    print("fail\tharness/featureslist.json sin la clave features")
    sys.exit(0)
if not isinstance(migrated, dict) or not migrated.get("ticket"):
    print("fail\tsin marca 'migrated_to': el backlog ya no vive aqui; ejecuta "
          "'harness archive --note ...' antes de volver a tocarlo")
    sys.exit(0)
print(
    "ok\tfeatureslist.json es archivo historico (%d features, migradas a GEAS el %s, ticket %s)"
    % (
        len(features),
        migrated.get("fecha", "?"),
        str(migrated.get("ticket", ""))[:8],
    )
)
PYEOF
  )"
  while IFS=$'\t' read -r status detail; do
    [ -z "$status" ] && continue
    case "$status" in
      ok) ok "archivo historico" "$detail" ;;
      fail) fail "archivo historico" "$detail" ;;
    esac
  done <<< "$ARCHIVE_OUT"
fi

# El servidor se consulta aqui, pero como AVISO y no como fallo: la puerta es
# local a proposito (si dependiera de la red, un fallo de internet tumbaria
# init.sh en todos los dispositivos a la vez). El arnes, en cambio, es
# fail-closed: sin GEAS no elige ni cierra trabajo.
if [ "${#PY[@]}" -gt 0 ]; then
  GEAS_OUT="$(run_py - <<'PYEOF' 2>&1 || true
import sys
from pathlib import Path

try:
    from agents.agents import geas_backlog
except Exception as exc:  # noqa: BLE001
    print(f"warn\tno se pudo cargar el cliente de GEAS: {exc}")
    sys.exit(0)

root = Path.cwd()
try:
    tickets = geas_backlog.available(root)
except geas_backlog.GeasUnavailable as exc:
    print(f"warn\tGEAS no responde: {exc}")
    sys.exit(0)
except Exception as exc:  # noqa: BLE001 - la puerta no se cae por esto
    print(f"warn\tGEAS inaccesible: {exc}")
    sys.exit(0)

libres = [geas_backlog.label(t) for t in tickets]
if libres:
    print("ok\t%d ticket(s) libre(s) en GEAS; siguiente: %s" % (len(libres), libres[0]))
else:
    print("ok\tGEAS responde; no hay tickets libres para este actor")
PYEOF
  )"
  # m5: si el interprete revienta (uv roto, import que peta antes del try...)
  # GEAS_OUT es una traza que no casa con ok|warn y el check desaparecia del
  # informe; un `ready` en verde podia convivir con un GEAS nunca comprobado.
  # Se registra un unico check con la primera linea inesperada, y si no hay
  # salida se registra igualmente.
  GEAS_CHECKED=0
  GEAS_UNEXPECTED=""
  while IFS=$'\t' read -r status detail; do
    [ -z "$status" ] && continue
    case "$status" in
      ok) ok "servidor GEAS" "$detail"; GEAS_CHECKED=1 ;;
      warn) warn "servidor GEAS" "$detail"; GEAS_CHECKED=1 ;;
      *) [ -z "$GEAS_UNEXPECTED" ] && GEAS_UNEXPECTED="$status ${detail:-}" ;;
    esac
  done <<< "$GEAS_OUT"
  if [ "$GEAS_CHECKED" -eq 0 ]; then
    if [ -n "$GEAS_UNEXPECTED" ]; then
      warn "servidor GEAS" "el probe devolvio algo inesperado: $GEAS_UNEXPECTED"
    else
      warn "servidor GEAS" "el probe no devolvio estado reconocible"
    fi
  fi
fi

section "Proyecto"
if [ -d "edgebet" ]; then ok "paquete" "edgebet/ presente"; else fail "paquete" "falta edgebet/"; fi
if [ -f "pyproject.toml" ]; then ok "pyproject" "presente"; else fail "pyproject" "falta pyproject.toml"; fi

if [ -d "tests" ]; then
  TEST_COUNT="$(find tests -name 'test_*.py' -type f 2>/dev/null | wc -l | tr -d ' ')"
  AGENT_TEST_COUNT="$(find agents/tests -name 'test_*.py' -type f 2>/dev/null | wc -l | tr -d ' ')"
  if [ "$TEST_COUNT" -gt 0 ]; then
    ok "tests" "$TEST_COUNT proyecto + $AGENT_TEST_COUNT agentes"
  else
    fail "tests" "no hay test_*.py"
  fi
else
  fail "tests" "falta tests/"
fi

section "Verificacion"
if [ "$QUICK" -eq 1 ]; then
  warn "pytest" "omitido por --quick"
elif [ "$ERRORS" -gt 0 ]; then
  warn "pytest" "omitido por errores estructurales"
elif [ "${#PY[@]}" -eq 0 ]; then
  fail "pytest" "no hay interprete Python"
else
  TEST_LOG="$(mktemp)"
  if "${TEST_RUNNER[@]}" tests/ agents/tests/ -q --no-header >"$TEST_LOG" 2>&1; then
    SUMMARY="$(grep -Eo '[0-9]+ passed[^=]*' "$TEST_LOG" | tail -1 | sed 's/[[:space:]]*$//' || true)"
    ok "pytest" "${SUMMARY:-suite en verde}"
  else
    DETAIL="$(grep -E '^(FAILED|ERROR)' "$TEST_LOG" | head -3 | tr '\n' ' ' || true)"
    fail "pytest" "${DETAIL:-la suite falla}"
    [ "$JSON" -eq 1 ] || tail -15 "$TEST_LOG" | sed 's/^/      /'
  fi
  rm -f "$TEST_LOG"
fi

if [ "$JSON" -eq 1 ]; then
  if [ "${#PY[@]}" -gt 0 ]; then
    REPORT="$REPORT" ERRORS="$ERRORS" WARNINGS="$WARNINGS" "${PY[@]}" - <<'PYEOF'
import json
import os

checks = []
for line in os.environ.get("REPORT", "").splitlines():
    parts = line.split("\t", 2)
    if len(parts) == 3:
        checks.append({"status": parts[0], "check": parts[1], "detail": parts[2]})
print(json.dumps({
    "ready": int(os.environ.get("ERRORS", "0")) == 0,
    "errors": int(os.environ.get("ERRORS", "0")),
    "warnings": int(os.environ.get("WARNINGS", "0")),
    "checks": checks,
}, indent=2, ensure_ascii=False))
PYEOF
  else
    printf '{"ready":false,"errors":1,"warnings":0,"checks":[]}\n'
  fi
elif [ "$ERRORS" -eq 0 ]; then
  printf '\n\033[1;32m== ENTORNO LISTO ==\033[0m (%d aviso(s))\n' "$WARNINGS"
  printf 'El backlog vive en el servidor GEAS: elige con "harness next" y reclama con ./start.sh.\n\n'
else
  printf '\n\033[1;31m== ENTORNO BLOQUEADO ==\033[0m (%d error(es), %d aviso(s))\n' "$ERRORS" "$WARNINGS"
  printf 'No empieces a implementar hasta resolver los checks fallidos.\n\n'
fi

[ "$ERRORS" -eq 0 ]
