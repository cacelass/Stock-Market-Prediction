# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover
.hypothesis/

# Translations
*.mo
*.pot

# Django stuff:
*.log

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# pyenv python configuration file
.python-version



# ipynb checkpoints
.ipynb_checkpoints
# --- Artefactos regenerables de conocimiento (NO se versionan) ---
# El índice vectorial ChromaDB se reconstruye con `make index-rag`.
.rag-index/
# La exportación cruda de graphify se regenera con `knowledge build`.
graphify-out/
# knowledge/ es la exportación por defecto de `knowledge build`; la bóveda
# canónica del repo es docs/vault/ (se versiona: es la capa de conocimiento estable).
knowledge/
# Skills de asistente generadas por `make skills` (los fuentes son agents/prompts/).
.opencode/skills/

# --- Configuración local ---
.env
.env.*
!.env.example

# --- Notas del vault autogeneradas por `knowledge build` (regenerables) ---
# Se versiona la ESTRUCTURA de dominios (docs/vault/00_META/..07_REFERENCIAS/ y su
# guia_modelos.md), no las notas que el agente knowledge exporta a la
# raíz y a code/docs/media/papers/references: eso se regenera con:
#   .venv/bin/python -m agents run knowledge build --vault_dir docs/vault
docs/vault/*.md
docs/vault/graph.canvas
docs/vault/00-index/
docs/vault/code/
docs/vault/docs/
docs/vault/media/
docs/vault/papers/
docs/vault/references/
